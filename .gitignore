# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# captured leads (local dev only — never commit real emails)
/data/leads.json

# video: Remotion's own dependency tree, and everything it renders.
# The root /node_modules rule is anchored and does not reach video/.
# Rendered MP4s never enter git — they go to C:\DayFive\staging\video\.
/video/node_modules
/video/out
*.mp4
*.mov
*.wav
*.mp3

# …but the GENERATED media the render is made from is a source asset, not
# build output. Veo and ElevenLabs have no seed: regenerating produces
# different footage, so a clean clone could not rebuild the film without
# these. Operator ruling 2026-09-20.
!/video/assets/broll/*.mp4
!/video/assets/vo/*.mp3
!/video/assets/ad-broll/*.mp4
!/video/assets/ad-vo/*.mp3

# Licensed music is a SOURCE ASSET too — bought, not generated, and equally
# unrebuildable from the repo. The rule that committed the Veo plates and the
# voiceover missed this folder, and three tracks were lost: staging was
# replaced upstream and the only other copy was deleted locally.
!/video/assets/music/*.wav
!/video/assets/music/*.mp3
!/video/assets/music/LICENSE.txt
!/video/assets/punch/*.wav
